# ===== JWT 认证 =====
# JWT 签名密钥（生产环境请更换为随机长字符串）
JWT_SECRET=dev_jwt_secret_change_in_production_2026
# Token 有效期（小时）
JWT_EXPIRE_HOURS=24

# ===== 管理员初始化 =====
# 首次部署时自动创建管理员账号
ADMIN_USERNAME=Mist
ADMIN_PASSWORD=changeme123

# ===== Gitee 图床 =====
GITEE_TOKEN=your_gitee_personal_access_token
GITEE_REPO_OWNER=your_gitee_username
GITEE_REPO_NAME=image-bed
GITEE_BRANCH=master
GITEE_IMAGE_PATH=images
