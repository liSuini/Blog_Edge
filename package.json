    "jsonwebtoken": "^9.0.2",
    "katex": "^0.18.5",
    "markdown-it": "^14.1.0",
    "markdown-it-mark": "^4.0.0",
    "md-editor-v3": "^4.20.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
